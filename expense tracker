import json
import os
if os.path.exists("expenses.json"):
    with open("expenses.json","r") as file :
        expenses=json.load(file)
else:
    expenses={"groceries":[],"rent":[]}
print("======EXPENSE TRACKER=======")
while True:
    try:
         menu = int(input("1.Add category in expenses\n"
              "2.Add Expense\n"
             "3.View Expense\n"
             "4.View spending\n"
             "5.View spending by category\n"
             "6.Delete expense\n"
             "7.Exit\n"
             "ENTER YOUR CHOICE :  "))
    except ValueError:
         print("Enter number 1 to 6")
         continue
    if menu == 7 :
        with open("expenses.json","w") as file:
             json.dump(expenses,file)
        print("Thank You!")
        break
    elif menu==1:
         while True:
            type_of_expenses=(input("Enter Types of expense(type q to move forward): "))
            if type_of_expenses=="q":
                break
            else:
                if type_of_expenses in expenses:
                    print("Type of expense already exists")
                else:
                    expenses[type_of_expenses]=[]
    elif menu==2:
        x=input("Where to add : ")
        if x in expenses:
            try:   
               added_amount = int(input("Amount: "))
               if added_amount<0:
                 print("Add only positive Integers!!")
               else:
                 expenses[x].append(added_amount)
            except ValueError:
                 print("Enter an Integer!!")
            
        else:
                 print("invalid entry")
    elif menu==3:
        for category in expenses:
            print(category,expenses[category])
            print("===Thank you===")
    elif menu==4:
        a=0
        for expense in expenses:
             for spending in expenses[expense]:
                  a+=spending
        print(a)
    elif menu==5:
        for category in expenses:
             print(category , sum(expenses[category]))
    elif menu==6:
         x=input("Where to remove : ")
         if x in expenses:
              amount = int(input("Amount : "))
              if amount in expenses[x]:
                   expenses[x].remove(amount)
              else:
                   print("Expense not found!!")
         else:
              print("Category not found")
    else:
            print("Invalid option")

     
